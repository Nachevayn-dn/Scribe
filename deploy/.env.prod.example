# Copy to deploy/.env.prod and fill in real values before deploying.
# Used by: docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod up -d --build

# Public domain Caddy will request a TLS certificate for (DNS A/AAAA record
# must already point at this host).
DOMAIN=scribe.example.com

# Long random string — e.g. `openssl rand -hex 32`. Never reuse the dev default.
JWT_SECRET=

# Required for real transcription (OpenAI Whisper) and clinical extraction (Claude).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
