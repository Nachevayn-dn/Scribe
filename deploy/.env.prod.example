# Copy to deploy/.env.prod and fill in real values. Never commit .env.prod.
#
#   cp deploy/.env.prod.example deploy/.env.prod
#   docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.prod.yml \
#     --env-file deploy/.env.prod up -d --build

# Your domain, DNS A/AAAA record already pointed at this VM's IP — Caddy
# provisions its own TLS certificate for it automatically. No https:// prefix.
DOMAIN=medicdesk.ai

# A long random string — anything works, but treat it like a password.
# One way to generate one: openssl rand -hex 32
JWT_SECRET=

# Required for real audio transcription (OpenAI Whisper) — platform.openai.com.
OPENAI_API_KEY=

# Required for clinical extraction / note generation — console.anthropic.com.
ANTHROPIC_API_KEY=
# Only needed if your key is a "multi-workspace" personal key (you'd see a
# 400 error mentioning anthropic-workspace-id otherwise). Not a secret.
ANTHROPIC_WORKSPACE_ID=

# Optional — required only for "Share via email". Free tier at resend.com.
# Leave RESEND_FROM_EMAIL as-is until you verify your own domain there.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MedicDesk.ai <onboarding@resend.dev>

# Optional — required only for the Inbound/Outbound phone agents
# (console.twilio.com). Real, billed usage on your Twilio account, unlike
# Resend's free tier.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional — swaps the inbound agent's robotic Twilio voice for a natural
# ElevenLabs one (elevenlabs.io/app/settings/api-keys). Leave blank to keep
# using Twilio's own voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Not set here — PUBLIC_BASE_URL and FRONTEND_BASE_URL are both derived
# automatically from DOMAIN above (see docker-compose.prod.yml).
