# Copy to .env at the repo root (docker compose auto-loads it for the
# ${VAR} substitutions in deploy/docker-compose.yml) and fill in real values.

JWT_SECRET=dev-secret-change-me

# Optional for local dev — leave blank to see the pipeline fail cleanly
# (encounter status -> FAILED with a clear reason) instead of crashing.
# Required for real audio transcription and clinical note generation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
