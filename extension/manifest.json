{
  "manifest_version": 3,
  "name": "MedicDesk.ai → PMS",
  "version": "1.0.0",
  "description": "Copies a MedicDesk.ai clinical note and pastes it into whatever field is focused in your PMS.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://medicdesk.ai/*",
    "https://*.medicdesk.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "https://medicdesk.ai/*", "https://*.medicdesk.ai/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
