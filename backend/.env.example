# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://scribe:scribe@localhost:5432/scribe

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=["http://localhost:5173"]

# Required for real audio transcription (OpenAI Whisper).
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Required for clinical extraction / note generation (Anthropic Claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if your ANTHROPIC_API_KEY is a "multi-workspace" personal key
# (you'll see a 400 error mentioning anthropic-workspace-id if so). Not a
# secret — find it at console.anthropic.com/settings/workspaces.
ANTHROPIC_WORKSPACE_ID=

AUDIO_STORAGE_DIR=./data/audio
AVATAR_STORAGE_DIR=./data/avatars

# Optional — required only to use "Share via email" (Integrations page).
# Get a free key at resend.com. Leave RESEND_FROM_EMAIL unset to send from
# Resend's shared onboarding@resend.dev address (fine to start); once you
# verify your own domain in Resend, set it to a real address there.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MedicDesk.ai <onboarding@resend.dev>

# Optional — required only for the Inbound/Outbound agents (phone, SMS,
# WhatsApp via Twilio, console.twilio.com). Unlike Resend's free tier, a
# phone number plus call/message usage are real billed charges on your
# Twilio account. Leave TWILIO_WHATSAPP_FROM as-is to use Twilio's shared
# sandbox number for testing; swap in your own verified WhatsApp Business
# number later, no code changes needed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The public URL Twilio calls back to (e.g. your ngrok URL, or your real
# deployment's URL once live) — needed before "Generate phone number" can
# wire up call/message routing.
PUBLIC_BASE_URL=
