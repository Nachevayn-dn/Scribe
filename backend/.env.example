# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://scribe:scribe@localhost:5432/scribe

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=["http://localhost:5173"]

# Required for real audio transcription (OpenAI Whisper).
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Required for clinical extraction / note generation (Anthropic Claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if your ANTHROPIC_API_KEY is a "multi-workspace" personal key
# (you'll see a 400 error mentioning anthropic-workspace-id if so). Not a
# secret — find it at console.anthropic.com/settings/workspaces.
ANTHROPIC_WORKSPACE_ID=

AUDIO_STORAGE_DIR=./data/audio
AVATAR_STORAGE_DIR=./data/avatars

# Optional — required only to use "Share via email" (Integrations page).
# Get a free key at resend.com. Leave RESEND_FROM_EMAIL unset to send from
# Resend's shared onboarding@resend.dev address (fine to start); once you
# verify your own domain in Resend, set it to a real address there.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MedicDesk.ai <onboarding@resend.dev>

# Optional — required only for the Inbound/Outbound agents (phone, SMS,
# WhatsApp via Twilio, console.twilio.com). Unlike Resend's free tier, a
# phone number plus call/message usage are real billed charges on your
# Twilio account. Leave TWILIO_WHATSAPP_FROM as-is to use Twilio's shared
# sandbox number for testing; swap in your own verified WhatsApp Business
# number later, no code changes needed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The public URL Twilio calls back to (e.g. your ngrok URL, or your real
# deployment's URL once live) — needed before "Generate phone number" can
# wire up call/message routing.
PUBLIC_BASE_URL=

# Optional — swaps the inbound agent's robotic Twilio voice for a natural
# ElevenLabs one (elevenlabs.io/app/settings/api-keys). Leave blank to keep
# using Twilio's own voice; nothing else changes either way.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional — required only for "Payment details" (Settings page, admin
# only). Get free test-mode keys at dashboard.stripe.com/apikeys (no
# business verification needed to test) — swap in live-mode keys
# (sk_live_.../pk_live_...) once ready to actually charge clinics. We never
# touch or store raw card numbers; Stripe.js collects the card in the
# browser and we only ever store the resulting Stripe customer id.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# The frontend app's own URL (not PUBLIC_BASE_URL above, which is the
# backend's webhook URL for Twilio) — used to build the "set your password"
# link emailed to a newly-provisioned doctor. Defaults to the local dev
# server; set this to your real domain (e.g. https://medicdesk.ai) once
# deployed so the emailed link actually reaches the recipient.
FRONTEND_BASE_URL=http://localhost:5173
